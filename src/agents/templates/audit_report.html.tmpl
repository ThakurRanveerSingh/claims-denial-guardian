<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Audit Report — $incident_id</title>
<style>
  :root {
    --critical: #c0392b;
    --high: #e67e22;
    --moderate: #d4a017;
    --cleared: #2e7d32;
    --unexamined: #78909c;
    --bg: #ffffff;
    --fg: #1a1a1a;
    --border: #d8d8d8;
    --panel: #f7f7f8;
  }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--fg);
    margin: 0;
    padding: 2rem;
    line-height: 1.5;
    max-width: 980px;
    margin-left: auto;
    margin-right: auto;
  }
  header {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-bottom: 3px solid var(--border);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  header h1 { margin: 0; font-size: 1.5rem; word-break: break-word; }
  .severity-badge {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
    color: white;
    white-space: nowrap;
  }
  .severity-critical { background: var(--critical); }
  .severity-high { background: var(--high); }
  .severity-moderate { background: var(--moderate); }
  .meta { color: #555; font-size: 0.95rem; }
  section { margin-bottom: 2.2rem; }
  h2 {
    font-size: 1.15rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.4rem;
  }
  h3 { font-size: 1rem; margin-bottom: 0.5rem; }
  table {
    border-collapse: collapse;
    width: 100%;
    margin: 0.75rem 0;
    font-size: 0.92rem;
  }
  th, td {
    border: 1px solid var(--border);
    padding: 0.5rem 0.6rem;
    text-align: left;
    vertical-align: top;
  }
  th { background: var(--panel); }
  .chart-panel { background: var(--panel); border: 1px solid var(--border); border-radius: 6px; padding: 1rem; margin: 0.75rem 0; }
  .bar-row { display: flex; align-items: center; gap: 0.75rem; margin: 0.4rem 0; }
  .bar-label { width: 160px; flex-shrink: 0; font-size: 0.9rem; }
  .bar-track { flex-grow: 1; background: #eaeaea; border-radius: 3px; height: 22px; position: relative; }
  .bar-fill { height: 100%; border-radius: 3px; }
  .bar-fill-segment { background: var(--critical); }
  .bar-fill-baseline { background: var(--unexamined); }
  .bar-value { margin-left: 0.6rem; font-variant-numeric: tabular-nums; font-size: 0.9rem; }
  .split-bar { display: flex; width: 100%; height: 26px; border-radius: 4px; overflow: hidden; border: 1px solid var(--border); }
  .split-segment { height: 100%; }
  .legend { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 0.6rem; font-size: 0.88rem; }
  .legend-item { display: flex; align-items: center; gap: 0.4rem; }
  .swatch { width: 12px; height: 12px; border-radius: 2px; display: inline-block; }
  .lineage-row { display: flex; align-items: center; flex-wrap: wrap; gap: 0.4rem; margin: 0.75rem 0; }
  .lineage-node {
    padding: 0.5rem 0.9rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    border: 2px solid transparent;
    white-space: nowrap;
  }
  .node-implicated { background: #fdecea; border-color: var(--critical); color: var(--critical); }
  .node-cleared { background: #eaf6ea; border-color: var(--cleared); color: var(--cleared); }
  .node-unexamined { background: #eceff1; border-color: var(--unexamined); color: #37474f; }
  .lineage-arrow { font-size: 1.1rem; color: #888; }
  .lineage-caption { margin: 0 0 0.5rem 0; font-size: 0.95rem; }
  .actions, .outstanding { background: var(--panel); border-left: 4px solid var(--unexamined); padding: 0.9rem 1.1rem; border-radius: 4px; }
  .outstanding { border-left-color: var(--moderate); }
  .appendix { background: var(--panel); border: 1px dashed var(--border); border-radius: 6px; padding: 1rem 1.2rem; font-size: 0.88rem; color: #555; }
  .appendix table { font-size: 0.85rem; }
  .appendix code { background: rgba(0,0,0,0.06); padding: 0.1rem 0.3rem; border-radius: 3px; }
  footer { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.85rem; color: #666; }
  a { color: #1a5fb4; }
  @media (prefers-color-scheme: dark) {
    body { background: #14161a; color: #e6e6e6; }
    .chart-panel, .actions, .outstanding { background: #1e2126; border-color: #33373d; }
    .appendix { background: #1a1c20; border-color: #3a3d43; color: #a8adb3; }
    .appendix code { background: rgba(255,255,255,0.08); }
    th { background: #24272d; }
    th, td { border-color: #33373d; }
    .bar-track { background: #2a2d33; }
    .node-cleared { background: #113319; }
    .node-implicated { background: #3a1613; }
    .node-unexamined { background: #23262b; color: #cfd8dc; }
    a { color: #6fa8f5; }
  }
</style>
</head>
<body>

<header>
  <h1>$incident_id</h1>
  <span class="severity-badge $severity_css_class">$severity</span>
  <span class="meta">Status: $status &middot; Generated: $generated_at</span>
</header>

<section>
  <h2>What was detected</h2>
  <div class="chart-panel">
    <div class="bar-row">
      <div class="bar-label">Segment rate</div>
      <div class="bar-track"><div class="bar-fill bar-fill-segment" style="width:$segment_bar_pct%"></div></div>
      <div class="bar-value">$segment_rate_display</div>
    </div>
    <div class="bar-row">
      <div class="bar-label">Baseline rate</div>
      <div class="bar-track"><div class="bar-fill bar-fill-baseline" style="width:$baseline_bar_pct%"></div></div>
      <div class="bar-value">$baseline_rate_display</div>
    </div>
  </div>
  <p>$detection_narrative_html</p>
</section>

<section>
  <h2>What the investigation established</h2>
  <p>$investigation_narrative_html</p>

  <h3>Origin split</h3>
  $origin_split_html

  <h3>Pipeline stages examined</h3>
  $lineage_diagram_html

  <h3>Root cause breakdown</h3>
  $breakdown_table_html
</section>

<section>
  <h2>Member impact</h2>
  <p>Denial counts for this segment, by reason code — read live from the database at report-generation time, not from a cached figure.</p>
  $member_impact_table_html
</section>

<section>
  <h2>Actions taken</h2>
  <div class="actions">$actions_taken_html</div>
</section>

<section>
  <h2>Outstanding items</h2>
  <div class="outstanding">$outstanding_items_html</div>
</section>

<section>
  <h2>Technical Appendix</h2>
  <div class="appendix">$technical_appendix_html</div>
</section>

<footer>
  Full incident record: <a href="$incident_json_url">$incident_json_url</a>
</footer>

</body>
</html>
